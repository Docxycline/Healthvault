# DATABASE_URL: PostgreSQL connection string (fallback to built-in development store if not configured)
DATABASE_URL="postgresql://user:password@localhost:5432/healthvault"

# GEMINI_API_KEY: Required for Gemini AI API calls (clinical summaries & document OCR)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret used to sign session cookies
SESSION_SECRET="healthvault_hackathon_super_secure_session_secret_2026"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
